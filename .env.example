# Gemini API Key (Get from https://aistudio.google.com/ - Free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# Email SMTP Settings (For automated reports)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_gmail_username@gmail.com
SENDER_PASSWORD=your_gmail_app_password_here
RECEIVER_EMAIL=your_receive_email@gmail.com
